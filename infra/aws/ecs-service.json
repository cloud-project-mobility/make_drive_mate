{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DriveMate single-task Fargate API and WebSocket relay behind private ALB and CloudFront; reuse existing database, queue and artifacts.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Resources": {
    "TaskSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Place replacement Fargate tasks in either AZ without a NAT gateway",
          "must": [
            "explicit public task IP is for outbound calls",
            "no public CIDR ingress"
          ]
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "CidrBlock": {
          "Ref": "TaskSubnetACidr"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "TaskRouteA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Reuse the existing internet gateway route for outbound SDK calls",
          "must": []
        }
      },
      "Properties": {
        "SubnetId": {
          "Ref": "TaskSubnetA"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTableId"
        }
      }
    },
    "TaskSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Place replacement Fargate tasks in either AZ without a NAT gateway",
          "must": [
            "explicit public task IP is for outbound calls",
            "no public CIDR ingress"
          ]
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "CidrBlock": {
          "Ref": "TaskSubnetBCidr"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "TaskRouteB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Reuse the existing internet gateway route for outbound SDK calls",
          "must": []
        }
      },
      "Properties": {
        "SubnetId": {
          "Ref": "TaskSubnetB"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTableId"
        }
      }
    },
    "TaskSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Allow external HTTPS APIs and private PostgreSQL; keep public task address closed",
          "must": [
            "no public CIDR ingress",
            "no SSH"
          ]
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "GroupDescription": "Fargate inbound from private ALB only",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "DestinationSecurityGroupId": {
              "Ref": "DbSecurityGroupId"
            }
          }
        ]
      }
    },
    "AlbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Only CloudFront may reach the private application listener",
          "must": [
            "viewer HTTPS",
            "no internet-facing ALB"
          ]
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "GroupDescription": "Internal ALB from CloudFront origin-facing addresses only",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixList"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "DestinationSecurityGroupId": {
              "Ref": "TaskSecurity"
            }
          }
        ]
      }
    },
    "TaskIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Route application requests through the private ALB only",
          "must": []
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "AlbSecurity"
        }
      }
    },
    "DatabaseIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Add Fargate access without replacing or editing existing database resources",
          "must": [
            "TLS verify-full at client",
            "preserve existing ingress"
          ]
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "DbSecurityGroupId"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Ref": "TaskSecurity"
        }
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "ECS injects selected application secret keys and pulls the immutable image",
          "must": [
            "no stored AWS credentials",
            "resource-scoped application permissions"
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": {
                    "Ref": "RepositoryArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${LogGroupName}:log-stream:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "AppSecretArn"
                    },
                    {
                      "Fn::If": [
                        "HasKakao",
                        {
                          "Ref": "KakaoSecretArn"
                        },
                        {
                          "Ref": "AWS::NoValue"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ApiTaskRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "API reads approved artifacts and aggregate report only; cannot write datasets or consume jobs",
          "must": [
            "no stored AWS credentials",
            "resource-scoped application permissions"
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}/${ReleaseKey}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}/${RagPointerKey}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}/data/cycles/latest.json"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}"
                  },
                  "Condition": {
                    "StringEquals": {
                      "s3:prefix": "data/cycles/latest.json"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "CycleTaskRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Separate one-shot cycle worker permissions from the interactive API",
          "must": [
            "no stored AWS credentials",
            "resource-scoped application permissions"
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}/${ReleaseKey}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}/data/cycles/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}"
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": "data/cycles/*"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:GetQueueAttributes",
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:ChangeMessageVisibility"
                  ],
                  "Resource": {
                    "Ref": "RefreshQueueArn"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Run a fixed image digest with ephemeral writable volumes",
          "must": [
            "non-root containers",
            "no database master credentials",
            "default encrypted 20 GiB ephemeral storage"
          ]
        }
      },
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Cpu": "1024",
        "Memory": "3072",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "ApiTaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "api",
            "Image": {
              "Ref": "ImageUri"
            },
            "Command": [
              "api"
            ],
            "Essential": true,
            "User": "10001:10001",
            "ReadonlyRootFilesystem": true,
            "LinuxParameters": {
              "InitProcessEnabled": true,
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            },
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "DRIVEMATE_RELEASE_BUCKET",
                "Value": {
                  "Ref": "DataBucket"
                }
              },
              {
                "Name": "DRIVEMATE_RELEASE_KEY",
                "Value": {
                  "Ref": "ReleaseKey"
                }
              },
              {
                "Name": "DRIVEMATE_RELEASE_SHA256",
                "Value": {
                  "Ref": "ReleaseSha256"
                }
              },
              {
                "Name": "DRIVEMATE_RAG_POINTER_KEY",
                "Value": {
                  "Ref": "RagPointerKey"
                }
              },
              {
                "Name": "DRIVEMATE_RAG_POINTER_SHA256",
                "Value": {
                  "Ref": "RagPointerSha256"
                }
              },
              {
                "Name": "DRIVEMATE_DB_HOST",
                "Value": {
                  "Ref": "DbHost"
                }
              },
              {
                "Name": "DRIVEMATE_ANALYTICS_LATEST_KEY",
                "Value": "data/cycles/latest.json"
              },
              {
                "Name": "DRIVEMATE_ALLOW_LLM",
                "Value": "true"
              },
              {
                "Name": "DRIVEMATE_PROVIDER_MODE",
                "Value": {
                  "Fn::If": [
                    "HasKakao",
                    "live",
                    "mock"
                  ]
                }
              },
              {
                "Name": "DRIVEMATE_LLM_DAILY_LIMIT",
                "Value": "20"
              },
              {
                "Name": "SPRING_SQL_INIT_MODE",
                "Value": "never"
              }
            ],
            "Secrets": [
              {
                "Name": "DRIVEMATE_DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${AppSecretArn}:DRIVEMATE_DB_PASSWORD::"
                }
              },
              {
                "Name": "OPENAI_API_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${AppSecretArn}:OPENAI_API_KEY::"
                }
              },
              {
                "Name": "OPENAI_MODEL",
                "ValueFrom": {
                  "Fn::Sub": "${AppSecretArn}:OPENAI_MODEL::"
                }
              },
              {
                "Name": "DRIVEMATE_KNOWLEDGE_ALLOWED_EMAILS",
                "ValueFrom": {
                  "Fn::Sub": "${AppSecretArn}:DRIVEMATE_KNOWLEDGE_ALLOWED_EMAILS::"
                }
              },
              {
                "Fn::If": [
                  "HasKakao",
                  {
                    "Name": "DRIVEMATE_KAKAO_REST_KEY",
                    "ValueFrom": {
                      "Fn::Sub": "${KakaoSecretArn}:DRIVEMATE_KAKAO_REST_KEY::"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              }
            ],
            "StopTimeout": 60,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroupName"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "api",
                "mode": "non-blocking",
                "max-buffer-size": "4m"
              }
            },
            "HealthCheck": {
              "Command": [
                "CMD",
                "/opt/drivemate/venv/bin/python",
                "/opt/drivemate/container/healthcheck.py",
                "api"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 120
            },
            "MountPoints": [
              {
                "SourceVolume": "runtime",
                "ContainerPath": "/opt/drivemate/runtime"
              },
              {
                "SourceVolume": "web",
                "ContainerPath": "/srv/drivemate-web"
              },
              {
                "SourceVolume": "api-tmp",
                "ContainerPath": "/tmp"
              }
            ]
          },
          {
            "Name": "nginx",
            "Image": {
              "Ref": "ImageUri"
            },
            "Command": [
              "nginx"
            ],
            "Essential": true,
            "User": "10001:10001",
            "ReadonlyRootFilesystem": true,
            "LinuxParameters": {
              "InitProcessEnabled": true,
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            },
            "Environment": [],
            "Secrets": [],
            "StopTimeout": 60,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroupName"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "nginx",
                "mode": "non-blocking",
                "max-buffer-size": "4m"
              }
            },
            "DependsOn": [
              {
                "ContainerName": "api",
                "Condition": "HEALTHY"
              }
            ],
            "StartTimeout": 120,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD",
                "/opt/drivemate/venv/bin/python",
                "/opt/drivemate/container/healthcheck.py",
                "nginx"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 15
            },
            "MountPoints": [
              {
                "SourceVolume": "web",
                "ContainerPath": "/srv/drivemate-web",
                "ReadOnly": true
              },
              {
                "SourceVolume": "nginx-tmp",
                "ContainerPath": "/tmp"
              }
            ]
          }
        ],
        "Volumes": [
          {
            "Name": "runtime"
          },
          {
            "Name": "web"
          },
          {
            "Name": "api-tmp"
          },
          {
            "Name": "nginx-tmp"
          }
        ]
      }
    },
    "CycleTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Run a fixed image digest with ephemeral writable volumes",
          "must": [
            "non-root containers",
            "no database master credentials",
            "default encrypted 20 GiB ephemeral storage"
          ]
        }
      },
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-cycle"
        },
        "Cpu": "1024",
        "Memory": "3072",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "CycleTaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "cycle",
            "Image": {
              "Ref": "ImageUri"
            },
            "Command": [
              "cycle"
            ],
            "Essential": true,
            "User": "10001:10001",
            "ReadonlyRootFilesystem": true,
            "LinuxParameters": {
              "InitProcessEnabled": true,
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            },
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "DRIVEMATE_RELEASE_BUCKET",
                "Value": {
                  "Ref": "DataBucket"
                }
              },
              {
                "Name": "DRIVEMATE_RELEASE_KEY",
                "Value": {
                  "Ref": "ReleaseKey"
                }
              },
              {
                "Name": "DRIVEMATE_RELEASE_SHA256",
                "Value": {
                  "Ref": "ReleaseSha256"
                }
              },
              {
                "Name": "DRIVEMATE_CYCLE_QUEUE_URL",
                "Value": {
                  "Ref": "RefreshQueueUrl"
                }
              },
              {
                "Name": "DRIVEMATE_DATA_BUCKET",
                "Value": {
                  "Ref": "DataBucket"
                }
              }
            ],
            "Secrets": [
              {
                "Name": "ONBID_SERVICE_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${AppSecretArn}:ONBID_SERVICE_KEY::"
                }
              }
            ],
            "StopTimeout": 60,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroupName"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "cycle",
                "mode": "non-blocking",
                "max-buffer-size": "4m"
              }
            },
            "MountPoints": [
              {
                "SourceVolume": "runtime",
                "ContainerPath": "/opt/drivemate/runtime"
              },
              {
                "SourceVolume": "cycle-tmp",
                "ContainerPath": "/tmp"
              }
            ]
          }
        ],
        "Volumes": [
          {
            "Name": "runtime"
          },
          {
            "Name": "cycle-tmp"
          }
        ]
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private ALB routes CloudFront HTTP and WebSocket traffic to Fargate",
          "must": [
            "two AZ subnets",
            "no public listener"
          ]
        }
      },
      "Properties": {
        "Type": "application",
        "Scheme": "internal",
        "IpAddressType": "ipv4",
        "Subnets": {
          "Ref": "AlbSubnetIds"
        },
        "SecurityGroups": [
          {
            "Ref": "AlbSecurity"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "130"
          },
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          }
        ]
      }
    },
    "Targets": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Check API readiness through Nginx before routing requests",
          "must": [
            "Fargate uses IP targets"
          ]
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/api/v1/health",
        "HealthCheckIntervalSeconds": 15,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "15"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "CloudFront connects over the private VPC path",
          "must": []
        }
      },
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Targets"
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Recover failed tasks in either AZ; keep exactly one process for same-account location relay",
          "must": [
            "one task, no autoscaling",
            "stop-first deployment causes brief disconnect",
            "rollback requires a previous completed deployment"
          ]
        }
      },
      "Properties": {
        "Cluster": {
          "Ref": "ClusterArn"
        },
        "TaskDefinition": {
          "Ref": "ApiTask"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DesiredCount": 1,
        "EnableExecuteCommand": false,
        "AvailabilityZoneRebalancing": "DISABLED",
        "HealthCheckGracePeriodSeconds": 180,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 0,
          "MaximumPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "TaskSubnetA"
              },
              {
                "Ref": "TaskSubnetB"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "TaskSecurity"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "nginx",
            "ContainerPort": 8080,
            "TargetGroupArn": {
              "Ref": "Targets"
            }
          }
        ],
        "EnableECSManagedTags": true,
        "PropagateTags": "SERVICE",
        "Tags": [
          {
            "Key": "Project",
            "Value": "DriveMate"
          }
        ]
      },
      "DependsOn": [
        "Listener",
        "TaskIngress",
        "DatabaseIngress",
        "TaskRouteA",
        "TaskRouteB"
      ]
    },
    "VpcOrigin": {
      "Type": "AWS::CloudFront::VpcOrigin",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Use private ALB connectivity for viewer HTTPS and WebSocket requests",
          "must": [
            "existing VPC must have internet gateway attached"
          ]
        }
      },
      "Properties": {
        "VpcOriginEndpointConfig": {
          "Arn": {
            "Ref": "LoadBalancer"
          },
          "Name": {
            "Fn::Sub": "${AWS::StackName}-origin"
          },
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "http-only"
        }
      },
      "DependsOn": "Listener"
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Managed HTTPS with authenticated responses never cached",
          "must": [
            "forward viewer Host, Authorization and WebSocket headers",
            "no original document data in static assets"
          ]
        }
      },
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "DriveMate Fargate HTTPS application",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_All",
          "Origins": [
            {
              "Id": "App",
              "DomainName": {
                "Fn::GetAtt": [
                  "LoadBalancer",
                  "DNSName"
                ]
              },
              "VpcOriginConfig": {
                "VpcOriginId": {
                  "Fn::GetAtt": [
                    "VpcOrigin",
                    "Id"
                  ]
                },
                "OriginReadTimeout": 120,
                "OriginKeepaliveTimeout": 5
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "App",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "DELETE",
              "GET",
              "HEAD",
              "OPTIONS",
              "PATCH",
              "POST",
              "PUT"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "216adef6-5c7f-47e4-b989-5492eafa07d3"
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        }
      }
    }
  },
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "PublicRouteTableId": {
      "Type": "String",
      "AllowedPattern": "rtb-[a-f0-9]+"
    },
    "AlbSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "Two existing private subnets in different AZs, with spare ALB and CloudFront ENI addresses."
    },
    "TaskSubnetACidr": {
      "Type": "String",
      "Default": "10.41.30.0/24",
      "AllowedPattern": "10\\.41\\.[0-9]{1,3}\\.0/24"
    },
    "TaskSubnetBCidr": {
      "Type": "String",
      "Default": "10.41.31.0/24",
      "AllowedPattern": "10\\.41\\.[0-9]{1,3}\\.0/24"
    },
    "DbSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "DbHost": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z0-9.-]+\\.rds\\.amazonaws\\.com"
    },
    "CloudFrontPrefixList": {
      "Type": "String",
      "AllowedPattern": "pl-[a-f0-9]+"
    },
    "ClusterArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:ecs:.*:cluster/.*"
    },
    "RepositoryArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:ecr:.*:repository/.*"
    },
    "ImageUri": {
      "Type": "String",
      "AllowedPattern": "[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9._/-]+@sha256:[a-f0-9]{64}"
    },
    "LogGroupName": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z0-9_./#-]+"
    },
    "DataBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9.-]{3,63}"
    },
    "ReleaseKey": {
      "Type": "String",
      "AllowedPattern": "releases/[a-zA-Z0-9._/-]+"
    },
    "ReleaseSha256": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{64}"
    },
    "RagPointerKey": {
      "Type": "String",
      "AllowedPattern": "(?:releases/[a-zA-Z0-9._/-]+|data/rag/pointers/[a-f0-9]{64}\\.json)"
    },
    "RagPointerSha256": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{64}"
    },
    "AppSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:.*"
    },
    "KakaoSecretArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(?:|arn:aws:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+)",
      "Description": "Optional existing secret ARN containing DRIVEMATE_KAKAO_REST_KEY; empty keeps provider mock mode."
    },
    "RefreshQueueUrl": {
      "Type": "String",
      "AllowedPattern": "https://sqs\\.[a-z0-9-]+\\.amazonaws\\.com/[0-9]{12}/[a-zA-Z0-9_-]+"
    },
    "RefreshQueueArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:sqs:.*"
    }
  },
  "Conditions": {
    "HasKakao": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "KakaoSecretArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Outputs": {
    "ServiceName": {
      "Value": {
        "Fn::GetAtt": [
          "Service",
          "Name"
        ]
      },
      "Description": "Single-task ECS API service"
    },
    "ServiceArn": {
      "Value": {
        "Ref": "Service"
      },
      "Description": "ECS service ARN"
    },
    "TaskDefinitionArn": {
      "Value": {
        "Ref": "ApiTask"
      },
      "Description": "Active API task definition"
    },
    "CycleTaskDefinitionArn": {
      "Value": {
        "Ref": "CycleTask"
      },
      "Description": "One-shot cycle task; no continuous service or schedule created"
    },
    "ExecutionRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "ExecutionRole",
          "Arn"
        ]
      },
      "Description": "ECS image, logs and secret injection role"
    },
    "ApiTaskRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "ApiTaskRole",
          "Arn"
        ]
      },
      "Description": "Artifact-read-only API role"
    },
    "CycleTaskRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "CycleTaskRole",
          "Arn"
        ]
      },
      "Description": "SQS consumer and cycle artifact writer role"
    },
    "TaskSubnetIds": {
      "Value": {
        "Fn::Join": [
          ",",
          [
            {
              "Ref": "TaskSubnetA"
            },
            {
              "Ref": "TaskSubnetB"
            }
          ]
        ]
      },
      "Description": "Outbound-capable task subnets"
    },
    "TaskSecurityGroupId": {
      "Value": {
        "Ref": "TaskSecurity"
      },
      "Description": "ALB-only task ingress"
    },
    "LoadBalancerArn": {
      "Value": {
        "Ref": "LoadBalancer"
      },
      "Description": "Private application load balancer"
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      },
      "Description": "CloudFront distribution"
    },
    "WebUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      },
      "Description": "Application HTTPS address"
    }
  }
}
