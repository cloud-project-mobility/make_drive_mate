# Configuration reference only. The application does not auto-load .env files.
# No-key demo: DRIVEMATE_PROVIDER_MODE=mock uv run --no-env-file --locked uvicorn app.main:app --host 127.0.0.1 --port 18085 --no-access-log
# Leave optional variables UNSET to use defaults; do not export every empty line.

# Optional runtime settings: default mock, data/drivemate.sqlite3, local Expo origins.
DRIVEMATE_PROVIDER_MODE=
DRIVEMATE_DATABASE=
DRIVEMATE_CORS_ORIGINS=

# Only needed for an explicitly enabled live integration; server-side only.
DRIVEMATE_KAKAO_REST_KEY=
DRIVEMATE_KAKAO_MOBILITY_KEY=
DRIVEMATE_GOOGLE_CLIENT_ID=
DRIVEMATE_GOOGLE_CLIENT_SECRET=
DRIVEMATE_GOOGLE_REDIRECT_URI=
DRIVEMATE_TOKEN_ENCRYPTION_KEY=

# Hyundai live authentication is not implemented; no fictional key variable.
