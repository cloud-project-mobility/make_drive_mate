#!/bin/sh
set -eu
cd "$(dirname "$0")"
version=3.9.16
maven=".tools/apache-maven-$version/bin/mvn"
if [ ! -x "$maven" ]; then
  mkdir -p .tools
  archive=".tools/apache-maven-$version-bin.tar.gz"
  curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$version/apache-maven-$version-bin.tar.gz" -o "$archive"
  printf '%s  %s\n' '831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6' "$archive" | sha512sum -c -
  tar -xzf "$archive" -C .tools
fi
exec "$maven" "$@"
